/*
 * Generated by Renoir
 * Base #c64600 | Harmony: Complementary | Tone: Jewel | Mode: Dark
 *
 * Use with the Fusion style. The stylesheet is self-contained; applying the
 * exported QPalette as well also themes link colors, dials and native dialogs.
 * Arrow images: export writes them to a "<name>-icons" folder next to this
 * file. Register it before applying: QDir.addSearchPath("renoir", <folder>)
 * Status colors: set a dynamic property, e.g. label.setProperty("status", "error").
 */

/* ---- General ---------------------------------------------------------- */
QWidget {
    background-color: #271b17;
    color: #f2e5e0;
    selection-background-color: #ec6d3b;
    selection-color: #16100e;
}
QWidget:disabled { color: #a29591; }
/* Plain QWidget containers (exact class) let their parent's background show. */
.QWidget { background-color: transparent; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QCheckBox, QRadioButton { spacing: 6px; }

/* ---- Indicators (drawn without images, so the .qss is self-contained) -- */
QCheckBox::indicator, QGroupBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: #191311;
    border: 1px solid #a29591;
}
QCheckBox::indicator, QGroupBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QGroupBox::indicator:hover,
QRadioButton::indicator:hover { border-color: #00a9ce; }
QCheckBox::indicator:checked, QGroupBox::indicator:checked {
    width: 10px;
    height: 10px;
    padding: 2px;
    background-clip: content;
    background-color: #00a9ce;
    border-color: #00a9ce;
}
QCheckBox::indicator:indeterminate {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #191311, stop:0.38 #191311, stop:0.39 #00a9ce,
        stop:0.61 #00a9ce, stop:0.62 #191311, stop:1 #191311);
    border-color: #00a9ce;
}
QRadioButton::indicator:checked {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 #00a9ce, stop:0.5 #00a9ce, stop:0.6 #191311, stop:1 #191311);
    border-color: #00a9ce;
}
QCheckBox::indicator:disabled, QGroupBox::indicator:disabled,
QRadioButton::indicator:disabled { background-color: #312420; border-color: #56433b; }
QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled {
    background-color: #a29591;
}
QRadioButton::indicator:checked:disabled {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 #a29591, stop:0.5 #a29591, stop:0.6 #312420, stop:1 #312420);
}

*[status="success"] { color: #47c86e; }
*[status="warning"] { color: #e39a00; }
*[status="error"]   { color: #ff7f71; }

/* ---- Buttons ---------------------------------------------------------- */
QPushButton {
    background-color: #502b1e;
    color: #fff9f6;
    border: 1px solid #56433b;
    border-radius: 5px;
    padding: 5px 14px;
}
QPushButton:hover { background-color: #5e382b; }
QPushButton:pressed, QPushButton:checked { background-color: #452114; }
QPushButton:default, QPushButton:focus { border-color: #00a9ce; }
QPushButton:flat { background-color: transparent; border-color: transparent; }
QPushButton:flat:hover { background-color: #5e382b; }
QPushButton:flat:disabled { background-color: transparent; border-color: transparent; }
QPushButton:disabled {
    background-color: #312420;
    color: #a29591;
    border-color: #56433b;
}
QToolButton {
    background-color: transparent;
    color: #f2e5e0;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px;
}
QToolButton:hover { background-color: #5e382b; border-color: #56433b; }
QToolButton:pressed, QToolButton:checked {
    background-color: #452114;
    border-color: #00a9ce;
}
QToolButton[popupMode="1"] { padding-right: 16px; }
QToolButton::menu-button {
    background-color: transparent;
    border: none;
    border-left: 1px solid #56433b;
    width: 14px;
}
QToolButton::menu-arrow, QToolButton::menu-indicator, QPushButton::menu-indicator {
    image: url(renoir:arrow-down-f2e5e0.svg);
    width: 10px;
    height: 6px;
}
QPushButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
}
QToolButton::menu-arrow:disabled, QToolButton::menu-indicator:disabled,
QPushButton::menu-indicator:disabled { image: url(renoir:arrow-down-a29591.svg); }

/* ---- Inputs ----------------------------------------------------------- */
QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox, QComboBox {
    background-color: #191311;
    color: #f2e5e0;
    border: 1px solid #56433b;
    border-radius: 5px;
    padding: 3px 5px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QAbstractSpinBox:focus, QComboBox:focus { border-color: #00a9ce; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QAbstractSpinBox:disabled, QComboBox:disabled {
    background-color: #312420;
    color: #a29591;
}
QAbstractSpinBox { padding-right: 20px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: transparent;
    border: none;
    border-left: 1px solid #56433b;
}
QAbstractSpinBox::up-button { subcontrol-position: top right; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #5e382b;
}
QAbstractSpinBox::up-arrow, QAbstractSpinBox::down-arrow { width: 10px; height: 6px; }
QAbstractSpinBox::up-arrow { image: url(renoir:arrow-up-f2e5e0.svg); }
QAbstractSpinBox::down-arrow { image: url(renoir:arrow-down-f2e5e0.svg); }
QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::up-arrow:off { image: url(renoir:arrow-up-a29591.svg); }
QAbstractSpinBox::down-arrow:disabled, QAbstractSpinBox::down-arrow:off { image: url(renoir:arrow-down-a29591.svg); }
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border: none;
    border-left: 1px solid #56433b;
}
QComboBox::down-arrow { image: url(renoir:arrow-down-f2e5e0.svg); width: 10px; height: 6px; }
QComboBox::down-arrow:disabled { image: url(renoir:arrow-down-a29591.svg); }
QComboBox QAbstractItemView {
    background-color: #191311;
    border: 1px solid #56433b;
    selection-background-color: #ec6d3b;
    selection-color: #16100e;
}

/* ---- Sliders & progress ----------------------------------------------- */
QSlider::groove:horizontal { height: 4px; background: #56433b; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background: #56433b; border-radius: 2px; }
QSlider::sub-page:horizontal, QSlider::add-page:vertical {
    background: #00a9ce;
    border-radius: 2px;
}
QSlider::handle:horizontal, QSlider::handle:vertical {
    background: #00a9ce;
    width: 16px;
    height: 16px;
    border-radius: 8px;
}
QSlider::handle:horizontal { margin: -6px 0; }
QSlider::handle:vertical { margin: 0 -6px; }
QSlider::handle:hover { background: #ec6d3b; }
QSlider::sub-page:disabled, QSlider::add-page:vertical:disabled,
QSlider::handle:disabled { background: #a29591; }
QProgressBar {
    background-color: #191311;
    color: #f2e5e0;
    border: 1px solid #56433b;
    border-radius: 5px;
    text-align: center;
    min-height: 16px;
}
QProgressBar::chunk { background-color: #00a9ce; border-radius: 4px; }
QProgressBar::chunk:disabled { background-color: #a29591; }

/* ---- Item views ------------------------------------------------------- */
QAbstractItemView {
    background-color: #191311;
    alternate-background-color: #241915;
    color: #f2e5e0;
    border: 1px solid #56433b;
    outline: 0;
}
QAbstractItemView::item { padding: 2px 4px; }
QAbstractItemView::item:hover { background-color: #241915; }
QAbstractItemView::item:selected { background-color: #ec6d3b; color: #16100e; }
QHeaderView { background-color: #312420; }
QHeaderView::section {
    background-color: #312420;
    color: #f2e5e0;
    border: none;
    border-right: 1px solid #56433b;
    border-bottom: 1px solid #56433b;
    padding: 4px 6px;
}
QTableView { gridline-color: #56433b; }
QTableCornerButton::section { background-color: #312420; border: none; }

/* ---- Scroll bars ------------------------------------------------------ */
QScrollBar:vertical { background: #271b17; width: 12px; margin: 0; border: none; }
QScrollBar:horizontal { background: #271b17; height: 12px; margin: 0; border: none; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #56433b;
    border-radius: 4px;
    margin: 2px;
}
QScrollBar::handle:vertical { min-height: 24px; }
QScrollBar::handle:horizontal { min-width: 24px; }
QScrollBar::handle:hover { background: #a29591; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ---- Containers ------------------------------------------------------- */
QGroupBox {
    background-color: #312420;
    border: 1px solid #56433b;
    border-radius: 5px;
    margin-top: 1.4em;
    padding: 8px 6px 6px 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #f2e5e0;
}
QTabWidget::pane {
    background-color: #271b17;
    border: 1px solid #56433b;
    border-radius: 5px;
    top: -1px;
}
QTabBar::tab {
    background-color: #312420;
    color: #a29591;
    border: 1px solid #56433b;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 5px 12px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #271b17;
    color: #f2e5e0;
    border-bottom: 2px solid #00a9ce;
}
QTabBar::tab:hover:!selected { background-color: #5e382b; color: #f2e5e0; }
QToolBox::tab {
    background-color: #312420;
    color: #f2e5e0;
    border: 1px solid #56433b;
    border-radius: 5px;
    padding: 4px 8px;
}
QToolBox::tab:selected { border-color: #00a9ce; color: #00a9ce; }
QSplitter::handle { background-color: #56433b; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical { height: 3px; }
QLCDNumber { background-color: #191311; color: #00a9ce; border: 1px solid #56433b; }

/* ---- Calendar --------------------------------------------------------- */
QCalendarWidget QWidget#qt_calendar_navigationbar { background-color: #312420; }
QCalendarWidget QToolButton { background-color: transparent; color: #f2e5e0; }
QCalendarWidget QToolButton:hover { background-color: #5e382b; }
QCalendarWidget QAbstractItemView {
    background-color: #191311;
    border: none;
    selection-background-color: #ec6d3b;
    selection-color: #16100e;
}

/* ---- Window chrome ---------------------------------------------------- */
QMenuBar {
    background-color: #312420;
    color: #f2e5e0;
    border-bottom: 1px solid #56433b;
}
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background-color: #ec6d3b; color: #16100e; }
QMenu {
    background-color: #191311;
    color: #f2e5e0;
    border: 1px solid #56433b;
    padding: 4px;
}
QMenu::item { padding: 5px 24px 5px 24px; border-radius: 4px; }
QMenu::item:selected { background-color: #ec6d3b; color: #16100e; }
QMenu::item:disabled { color: #a29591; }
QMenu::separator { height: 1px; background: #56433b; margin: 4px 8px; }
QToolBar {
    background-color: #312420;
    border: none;
    border-bottom: 1px solid #56433b;
    spacing: 4px;
    padding: 3px;
}
QToolBar::separator { background: #56433b; width: 1px; margin: 4px; }
QStatusBar {
    background-color: #312420;
    color: #a29591;
    border-top: 1px solid #56433b;
}
QDockWidget { color: #f2e5e0; }
QDockWidget::title {
    background-color: #312420;
    border: 1px solid #56433b;
    padding: 5px;
}
QToolTip {
    background-color: #013c4b;
    color: #fff9f6;
    border: 1px solid #56433b;
    padding: 4px;
}
