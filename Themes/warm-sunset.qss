/* Warm Sunset — warm reds on near-white
 * Scribe colour theme as a Qt stylesheet (reference copy).
 * Generated from themes.txt; Scribe itself applies these colours as a
 * QPalette with the Fusion style, so editing this file does not change the app.
 *
 *   base     #f8f9fa   editor / list background
 *   window   #ffedc2   toolbar, menus, panels
 *   text     #1a1a2e
 *   accent   #ff6b6b   selection highlight
 *   link     #b34b4b
 *   heading  #bf5050
 */

QWidget {
    background-color: #ffedc2;
    color: #1a1a2e;
    selection-background-color: #ff6b6b;
    selection-color: #000000;
}

QWidget:disabled {
    color: #898a94;
}

/* Editing and list areas */
QPlainTextEdit, QTextEdit, QTextBrowser, QLineEdit, QSpinBox, QComboBox,
QListView, QTreeView, QTreeWidget, QTableView {
    background-color: #f8f9fa;
    color: #1a1a2e;
    border: 1px solid #d9c9a5;
}

QTreeView, QListView, QTableView {
    alternate-background-color: #eff0f2;
}

QTreeView::item:selected, QListView::item:selected {
    background-color: #ff6b6b;
    color: #000000;
}

/* Menus */
QMenuBar {
    background-color: #ffedc2;
    color: #1a1a2e;
}

QMenuBar::item:selected, QMenu::item:selected {
    background-color: #ff6b6b;
    color: #000000;
}

QMenu {
    background-color: #ffedc2;
    color: #1a1a2e;
    border: 1px solid #d9c9a5;
}

QMenu::separator {
    height: 1px;
    background: #d9c9a5;
    margin: 4px 8px;
}

/* Toolbar and status bar */
QToolBar {
    background-color: #ffedc2;
    border: none;
    spacing: 2px;
}

QToolButton:hover, QToolButton:checked {
    background-color: #f1e0b9;
    border: 1px solid #d9c9a5;
    border-radius: 3px;
}

QStatusBar {
    background-color: #ffedc2;
    color: #1a1a2e;
}

/* Tabs */
QTabBar::tab {
    background-color: #f1e0b9;
    color: #1a1a2e;
    padding: 4px 10px;
    border: 1px solid #d9c9a5;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #f8f9fa;
    color: #1a1a2e;
}

/* Buttons */
QPushButton {
    background-color: #f1e0b9;
    color: #1a1a2e;
    border: 1px solid #d9c9a5;
    border-radius: 3px;
    padding: 4px 14px;
}

QPushButton:hover {
    background-color: #ffeec6;
}

QPushButton:pressed {
    background-color: #a69a7e;
}

QPushButton:default {
    border-color: #ff6b6b;
}

/* Scroll bars */
QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #ffedc2;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #d9c9a5;
    border-radius: 4px;
}

QToolTip {
    background-color: #f8f9fa;
    color: #1a1a2e;
    border: 1px solid #d9c9a5;
}

QSplitter::handle {
    background-color: #d9c9a5;
}
