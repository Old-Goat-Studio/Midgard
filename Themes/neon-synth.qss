/* Neon Synth — high-energy gradients
 * Scribe colour theme as a Qt stylesheet (reference copy).
 * Generated from themes.txt; Scribe itself applies these colours as a
 * QPalette with the Fusion style, so editing this file does not change the app.
 *
 *   base     #170541   editor / list background
 *   window   #330452   toolbar, menus, panels
 *   text     #c0ecfa
 *   accent   #f72585   selection highlight
 *   link     #4cc9f0
 *   heading  #f72585
 */

QWidget {
    background-color: #330452;
    color: #c0ecfa;
    selection-background-color: #f72585;
    selection-color: #000000;
}

QWidget:disabled {
    color: #6c799e;
}

/* Editing and list areas */
QPlainTextEdit, QTextEdit, QTextBrowser, QLineEdit, QSpinBox, QComboBox,
QListView, QTreeView, QTreeWidget, QTableView {
    background-color: #170541;
    color: #c0ecfa;
    border: 1px solid #2b0346;
}

QTreeView, QListView, QTableView {
    alternate-background-color: #1e0e48;
}

QTreeView::item:selected, QListView::item:selected {
    background-color: #f72585;
    color: #000000;
}

/* Menus */
QMenuBar {
    background-color: #330452;
    color: #c0ecfa;
}

QMenuBar::item:selected, QMenu::item:selected {
    background-color: #f72585;
    color: #000000;
}

QMenu {
    background-color: #330452;
    color: #c0ecfa;
    border: 1px solid #2b0346;
}

QMenu::separator {
    height: 1px;
    background: #2b0346;
    margin: 4px 8px;
}

/* Toolbar and status bar */
QToolBar {
    background-color: #330452;
    border: none;
    spacing: 2px;
}

QToolButton:hover, QToolButton:checked {
    background-color: #3b125c;
    border: 1px solid #2b0346;
    border-radius: 3px;
}

QStatusBar {
    background-color: #330452;
    color: #c0ecfa;
}

/* Tabs */
QTabBar::tab {
    background-color: #3b125c;
    color: #c0ecfa;
    padding: 4px 10px;
    border: 1px solid #2b0346;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #170541;
    color: #c0ecfa;
}

/* Buttons */
QPushButton {
    background-color: #3b125c;
    color: #c0ecfa;
    border: 1px solid #2b0346;
    border-radius: 3px;
    padding: 4px 14px;
}

QPushButton:hover {
    background-color: #41165e;
}

QPushButton:pressed {
    background-color: #210335;
}

QPushButton:default {
    border-color: #f72585;
}

/* Scroll bars */
QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #330452;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #2b0346;
    border-radius: 4px;
}

QToolTip {
    background-color: #170541;
    color: #c0ecfa;
    border: 1px solid #2b0346;
}

QSplitter::handle {
    background-color: #2b0346;
}
