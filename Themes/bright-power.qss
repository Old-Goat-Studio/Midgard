/* Bright Power — bold magenta/yellow/blue
 * Scribe colour theme as a Qt stylesheet (reference copy).
 * Generated from themes.txt; Scribe itself applies these colours as a
 * QPalette with the Fusion style, so editing this file does not change the app.
 *
 *   base     #fffde7   editor / list background
 *   window   #bff7ff   toolbar, menus, panels
 *   text     #00255c
 *   accent   #ff1d58   selection highlight
 *   link     #0049b7
 *   heading  #ff1d58
 */

QWidget {
    background-color: #bff7ff;
    color: #00255c;
    selection-background-color: #ff1d58;
    selection-color: #000000;
}

QWidget:disabled {
    color: #8091a2;
}

/* Editing and list areas */
QPlainTextEdit, QTextEdit, QTextBrowser, QLineEdit, QSpinBox, QComboBox,
QListView, QTreeView, QTreeWidget, QTableView {
    background-color: #fffde7;
    color: #00255c;
    border: 1px solid #a2d2d9;
}

QTreeView, QListView, QTableView {
    alternate-background-color: #f5f4e1;
}

QTreeView::item:selected, QListView::item:selected {
    background-color: #ff1d58;
    color: #000000;
}

/* Menus */
QMenuBar {
    background-color: #bff7ff;
    color: #00255c;
}

QMenuBar::item:selected, QMenu::item:selected {
    background-color: #ff1d58;
    color: #000000;
}

QMenu {
    background-color: #bff7ff;
    color: #00255c;
    border: 1px solid #a2d2d9;
}

QMenu::separator {
    height: 1px;
    background: #a2d2d9;
    margin: 4px 8px;
}

/* Toolbar and status bar */
QToolBar {
    background-color: #bff7ff;
    border: none;
    spacing: 2px;
}

QToolButton:hover, QToolButton:checked {
    background-color: #b4eaf5;
    border: 1px solid #a2d2d9;
    border-radius: 3px;
}

QStatusBar {
    background-color: #bff7ff;
    color: #00255c;
}

/* Tabs */
QTabBar::tab {
    background-color: #b4eaf5;
    color: #00255c;
    padding: 4px 10px;
    border: 1px solid #a2d2d9;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #fffde7;
    color: #00255c;
}

/* Buttons */
QPushButton {
    background-color: #b4eaf5;
    color: #00255c;
    border: 1px solid #a2d2d9;
    border-radius: 3px;
    padding: 4px 14px;
}

QPushButton:hover {
    background-color: #c3f8ff;
}

QPushButton:pressed {
    background-color: #7ca1a6;
}

QPushButton:default {
    border-color: #ff1d58;
}

/* Scroll bars */
QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #bff7ff;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #a2d2d9;
    border-radius: 4px;
}

QToolTip {
    background-color: #fffde7;
    color: #00255c;
    border: 1px solid #a2d2d9;
}

QSplitter::handle {
    background-color: #a2d2d9;
}
