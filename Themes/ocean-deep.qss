/* Ocean Deep — cool blues and teals
 * Scribe colour theme as a Qt stylesheet (reference copy).
 * Generated from themes.txt; Scribe itself applies these colours as a
 * QPalette with the Fusion style, so editing this file does not change the app.
 *
 *   base     #0a2342   editor / list background
 *   window   #0d3b53   toolbar, menus, panels
 *   text     #cadebf
 *   accent   #126872   selection highlight
 *   link     #84bc9c
 *   heading  #2ca58d
 */

QWidget {
    background-color: #0d3b53;
    color: #cadebf;
    selection-background-color: #126872;
    selection-color: #ffffff;
}

QWidget:disabled {
    color: #6a8181;
}

/* Editing and list areas */
QPlainTextEdit, QTextEdit, QTextBrowser, QLineEdit, QSpinBox, QComboBox,
QListView, QTreeView, QTreeWidget, QTableView {
    background-color: #0a2342;
    color: #cadebf;
    border: 1px solid #0b3247;
}

QTreeView, QListView, QTableView {
    alternate-background-color: #122a47;
}

QTreeView::item:selected, QListView::item:selected {
    background-color: #126872;
    color: #ffffff;
}

/* Menus */
QMenuBar {
    background-color: #0d3b53;
    color: #cadebf;
}

QMenuBar::item:selected, QMenu::item:selected {
    background-color: #126872;
    color: #ffffff;
}

QMenu {
    background-color: #0d3b53;
    color: #cadebf;
    border: 1px solid #0b3247;
}

QMenu::separator {
    height: 1px;
    background: #0b3247;
    margin: 4px 8px;
}

/* Toolbar and status bar */
QToolBar {
    background-color: #0d3b53;
    border: none;
    spacing: 2px;
}

QToolButton:hover, QToolButton:checked {
    background-color: #184559;
    border: 1px solid #0b3247;
    border-radius: 3px;
}

QStatusBar {
    background-color: #0d3b53;
    color: #cadebf;
}

/* Tabs */
QTabBar::tab {
    background-color: #184559;
    color: #cadebf;
    padding: 4px 10px;
    border: 1px solid #0b3247;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #0a2342;
    color: #cadebf;
}

/* Buttons */
QPushButton {
    background-color: #184559;
    color: #cadebf;
    border: 1px solid #0b3247;
    border-radius: 3px;
    padding: 4px 14px;
}

QPushButton:hover {
    background-color: #1e495f;
}

QPushButton:pressed {
    background-color: #082636;
}

QPushButton:default {
    border-color: #126872;
}

/* Scroll bars */
QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #0d3b53;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #0b3247;
    border-radius: 4px;
}

QToolTip {
    background-color: #0a2342;
    color: #cadebf;
    border: 1px solid #0b3247;
}

QSplitter::handle {
    background-color: #0b3247;
}
