{
  "description": "Every third-party component Midgard uses. 'ships_in' says where it ends up: 'runtime' (inside every exported game and server), 'editor' (the editor only), or 'build' (build and test tools, never shipped). tools/licenses.py checks this list in CI and builds THIRD_PARTY_NOTICES.txt from it.",
  "components": [
    { "name": "nlohmann-json", "source": "vcpkg", "license": "MIT", "ships_in": "runtime", "url": "https://github.com/nlohmann/json", "copyright": "Copyright (c) 2013-2025 Niels Lohmann" },
    { "name": "sqlite3", "source": "vcpkg", "license": "blessing", "ships_in": "runtime", "url": "https://sqlite.org", "copyright": "SQLite is in the public domain." },
    { "name": "doctest", "source": "vcpkg", "license": "MIT", "ships_in": "build", "url": "https://github.com/doctest/doctest", "copyright": "Copyright (c) 2016-2023 Viktor Kirilov" },
    { "name": "PySide6", "source": "python", "license": "LGPL-3.0-only", "ships_in": "editor", "url": "https://pyside.org", "copyright": "Copyright (C) The Qt Company Ltd." },
    { "name": "PySide6-QtAds", "source": "python", "license": "LGPL-2.1-only", "ships_in": "editor", "url": "https://github.com/mborgerson/pyside6_qtads", "copyright": "Copyright (C) Uwe Kindler, Matt Borgerson and contributors" },
    { "name": "jsonschema", "source": "python", "license": "MIT", "ships_in": "editor", "url": "https://github.com/python-jsonschema/jsonschema", "copyright": "Copyright (c) 2013 Julian Berman" },
    { "name": "pytest", "source": "python", "license": "MIT", "ships_in": "build", "url": "https://pytest.org", "copyright": "Copyright (c) 2004 Holger Krekel and others" },
    { "name": "clang-format", "source": "python", "license": "Apache-2.0 WITH LLVM-exception", "ships_in": "build", "url": "https://github.com/ssciwr/clang-format-wheel", "copyright": "Copyright (c) LLVM Project contributors" },
    { "name": "ruff", "source": "python", "license": "MIT", "ships_in": "build", "url": "https://github.com/astral-sh/ruff", "copyright": "Copyright (c) 2022 Charles Marsh" }
  ],
  "allowed": {
    "runtime": ["MIT", "MIT-0", "BSD-2-Clause", "BSD-3-Clause", "Zlib", "Apache-2.0", "BSL-1.0", "blessing", "Unlicense", "PSF-2.0", "Unicode-3.0"],
    "editor": ["MIT", "MIT-0", "BSD-2-Clause", "BSD-3-Clause", "Zlib", "Apache-2.0", "BSL-1.0", "blessing", "Unlicense", "PSF-2.0", "Unicode-3.0", "LGPL-2.1-only", "LGPL-2.1-or-later", "LGPL-3.0-only", "LGPL-3.0-or-later"],
    "build": ["MIT", "MIT-0", "BSD-2-Clause", "BSD-3-Clause", "Zlib", "Apache-2.0", "Apache-2.0 WITH LLVM-exception", "BSL-1.0", "blessing", "Unlicense", "PSF-2.0"]
  }
}
