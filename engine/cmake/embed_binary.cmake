# A binary file as a C++ source: a byte array and its size, in namespace midgard::embedded.
#   cmake -DOUTPUT=<file.cpp> -DNAME=<array name> -DINPUT=<file> -P embed_binary.cmake
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR size "${digits} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# (a line break every 8 bytes keeps the file readable and the compiler's lines short)
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n" bytes "${bytes}")
file(WRITE "${OUTPUT}"
    "// Generated by engine/cmake/embed_binary.cmake from ${INPUT}: do not edit.\n"
    "#include <cstddef>\n#include <cstdint>\n\n"
    "namespace midgard::embedded {\n"
    "extern const std::uint8_t ${NAME}[];\nextern const std::size_t ${NAME}_size;\n"
    "const std::uint8_t ${NAME}[] = {\n${bytes}\n};\n"
    "const std::size_t ${NAME}_size = ${size};\n"
    "}  // namespace midgard::embedded\n")
