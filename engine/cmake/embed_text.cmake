# Text files as a C++ header: one array of string pieces (raw strings, kept short for MSVC's
# limit on a literal's length), joined in order at run time.
#   cmake -DOUTPUT=<header> -DNAME=<array name> -DINPUTS="<file>;<file>" -P embed_text.cmake
set(text "")
foreach(input ${INPUTS})
    file(READ "${input}" content)
    get_filename_component(file_name "${input}" NAME)
    string(APPEND text "// ---- ${file_name} ----\n${content}\n")
endforeach()
string(LENGTH "${text}" length)
set(out "// Generated by engine/cmake/embed_text.cmake: do not edit.\n#pragma once\n\n")
string(APPEND out "inline const char* const ${NAME}[] = {\n")
set(chunk 3000)
set(at 0)
while(at LESS length)
    string(SUBSTRING "${text}" ${at} ${chunk} piece)
    string(APPEND out "    R\"MIDGARD(${piece})MIDGARD\",\n")
    math(EXPR at "${at} + ${chunk}")
endwhile()
string(APPEND out "};\n")
file(WRITE "${OUTPUT}" "${out}")
