<rml>
<head>
    <title>HUD</title>
    <link type="text/rcss" href="midgard://base.rcss"/>
    <style>
        /* Midgard's HUD: nothing on it takes the mouse, so clicks reach the game. */
        body { pointer-events: none; font-size: 16dp; box-sizing: border-box; }
        /* (inside the safe area: the body's padding) */
        #frame { position: relative; width: 100%; height: 100%; }
        div, p, span { pointer-events: none; }
        .shadow { font-effect: shadow(1dp 1dp #000000c0); }

        #bars { position: absolute; left: 16dp; top: 16dp; width: 240dp; }
        .stat { margin-bottom: 8dp; }
        .stat .name { display: inline; }
        .stat .value { display: inline; float: right; color: #d8dee8; }
        .track { height: 12dp; margin-top: 3dp; background-color: #00000080;
                 border: 1dp #ffffff40; border-radius: 3dp; }
        .fill { height: 100%; border-radius: 2dp; background-color: #6fbf73; }
        #bar-health .fill { background-color: #d9534f; }
        #bar-stamina .fill { background-color: #e0b040; }
        #bar-mana .fill { background-color: #4f86d9; }

        #right { position: absolute; right: 16dp; top: 16dp; width: 260dp; text-align: right; }
        .number { margin-bottom: 4dp; font-size: 20dp; }
        .number .name { color: #c8d0dc; font-size: 16dp; }
        .timer { margin-bottom: 4dp; font-size: 20dp; color: #ffd27a; }
        #notes { margin-top: 12dp; }
        .note { margin-bottom: 6dp; padding: 6dp 10dp; background-color: #10141cb0;
                border-radius: 4dp; text-align: left; }

        #prompt { position: absolute; left: 0; right: 0; bottom: 64dp; text-align: center; }
        #prompt span { padding: 8dp 16dp; background-color: #10141cc0; border-radius: 6dp;
                       font-size: 20dp; }

        #crosshair { position: absolute; left: 50%; top: 50%; width: 6dp; height: 6dp;
                     margin-left: -3dp; margin-top: -3dp; border-radius: 3dp;
                     background-color: #ffffffd0; border: 1dp #000000a0; }
        /* A phone held upright: the two sides share the width. */
        @media (orientation: portrait) {
            #bars { width: 44%; }
            #right { width: 44%; }
        }
    </style>
</head>
<body data-model="hud">
    <div id="frame" data-if="visible">
        <div id="bars">
            <div class="stat shadow" data-for="bar : bars" data-attr-id="'bar-' + bar.id">
                <span class="name">{{bar.name}}</span><span class="value">{{bar.text}}</span>
                <div class="track"><div class="fill" data-style-width="bar.percent + '%'"></div></div>
            </div>
        </div>
        <div id="right">
            <div class="number shadow" data-for="n : numbers">
                <span class="name">{{n.name}} </span>{{n.text}}</div>
            <div class="timer shadow" data-for="t : timers">{{t.label}} {{t.text}}</div>
            <div id="notes">
                <div class="note" data-for="note : notes" data-style-opacity="note.opacity">{{note.text}}</div>
            </div>
        </div>
        <p id="prompt" data-if="has_prompt"><span class="shadow">{{prompt}}</span></p>
        <div id="crosshair" data-if="crosshair"></div>
    </div>
</body>
</rml>
