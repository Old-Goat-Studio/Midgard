<rml>
<head>
    <title>HUD</title>
    <link type="text/rcss" href="midgard://base.rcss"/>
    <style>
        /* Midgard's HUD: nothing on it takes the mouse, so clicks reach the game. */
        body { pointer-events: none; font-size: 16dp; box-sizing: border-box; }
        /* (inside the safe area: the body's padding) */
        #frame { position: relative; width: 100%; height: 100%; }
        div, p, span { pointer-events: none; }
        .shadow { font-effect: shadow(1dp 1dp #000000c0); }

        #bars { position: absolute; left: 16dp; top: 16dp; width: 240dp; }
        .stat { margin-bottom: 8dp; }
        .stat .name { display: inline; }
        .stat .value { display: inline; float: right; color: #d8dee8; }
        .track { height: 12dp; margin-top: 3dp; background-color: #00000080;
                 border: 1dp #ffffff40; border-radius: 3dp; }
        .fill { height: 100%; border-radius: 2dp; background-color: #6fbf73; }
        #bar-health .fill { background-color: #d9534f; }
        #bar-stamina .fill { background-color: #e0b040; }
        #bar-mana .fill { background-color: #4f86d9; }

        #right { position: absolute; right: 16dp; top: 16dp; width: 260dp; text-align: right; }
        .number { margin-bottom: 4dp; font-size: 20dp; }
        .number .name { color: #c8d0dc; font-size: 16dp; }
        .timer { margin-bottom: 4dp; font-size: 20dp; color: #ffd27a; }
        #notes { margin-top: 12dp; }
        .note { margin-bottom: 6dp; padding: 6dp 10dp; background-color: #10141cb0;
                border-radius: 4dp; text-align: left; }

        #prompt { position: absolute; left: 0; right: 0; bottom: 64dp; text-align: center; }
        #prompt span { padding: 8dp 16dp; background-color: #10141cc0; border-radius: 6dp;
                       font-size: 20dp; }

        /* The game's own crosshair picture (the Project Page's), centred. */
        #crosshair_picture { position: absolute; left: 50%; top: 50%;
                             decorator: image(midgard://image/hud_crosshair contain); }
        #crosshair { position: absolute; left: 50%; top: 50%; width: 6dp; height: 6dp;
                     margin-left: -3dp; margin-top: -3dp; border-radius: 3dp;
                     background-color: #ffffffd0; border: 1dp #000000a0; }
        /* The compass: a strip of marks sliding under a window 300 dp wide. */
        #compass { position: absolute; left: 50%; top: 12dp; width: 300dp; height: 30dp;
                   margin-left: -150dp; overflow: hidden; clip: always; background-color: #10141c90; }
        /* (square, and clip: always: RmlUi doesn't count absolutely placed parts as overflowing,
           and a rounded box would need clip masks, which Midgard doesn't draw yet) */
        /* (in a row, each 15 degrees wide, so the window clips them) */
        #strip { position: absolute; top: 0; height: 30dp; width: 1850dp; white-space: nowrap;
                 margin-left: -18.75dp; }
        .tick { display: inline-block; width: 37.5dp; height: 30dp; line-height: 30dp;
                text-align: center; font-size: 12dp; color: #b8c4d8a0; }
        .tick.major { font-size: 17dp; color: #ffffff; }
        #needle { position: absolute; left: 149dp; top: 0; width: 2dp; height: 6dp;
                  background-color: #ffd27a; }

        /* The minimap: north up, the player in the middle. */
        #minimap { position: absolute; right: 16dp; bottom: 16dp; width: 160dp; height: 160dp;
                   overflow: hidden; clip: always; background-color: #1c2a1ce0;
                   border: 2dp #ffffff60; }
        #ground { position: absolute; }
        .mark { position: absolute; width: 10dp; height: 10dp; margin-left: -5dp;
                margin-top: -5dp; border-radius: 5dp; background-color: #ffd27a;
                border: 1dp #000000a0; }
        .mark.exit { background-color: #6fb6ff; border-radius: 2dp; }
        .mark.portal { background-color: #b07aff; }
        .mark-label { position: absolute; left: 12dp; top: -4dp; width: 120dp;
                      font-size: 12dp; }
        #arrow { position: absolute; left: 50%; top: 50%; width: 24dp; height: 24dp;
                 margin-left: -12dp; margin-top: -12dp; }
        #arrow .nose { position: absolute; left: 9dp; top: 0; width: 6dp; height: 14dp;
                       background-color: #ffd27a; border: 1dp #000000c0; border-radius: 3dp; }
        #arrow .body { position: absolute; left: 6dp; top: 9dp; width: 12dp; height: 12dp;
                       background-color: #ffffff; border: 1dp #000000c0; border-radius: 6dp; }
        #north { position: absolute; left: 50%; top: 2dp; width: 16dp; margin-left: -8dp;
                 text-align: center; font-size: 12dp; color: #ffffffc0; }

        /* The full map: 3/4 of the window, the map in its own proportions inside. */
        #bigmap { position: absolute; left: 12.5%; top: 12.5%; width: 75%; height: 75%;
                  background-color: #0c1018e8; border: 2dp #ffffff60; border-radius: 6dp; }
        #bigmap-title { position: absolute; left: 12dp; right: 12dp; top: 0; height: 36dp;
                        line-height: 36dp; font-size: 20dp; }
        #bigmap-hint { position: absolute; right: 0; top: 0; font-size: 14dp; color: #c8d0dc; }
        #bigmap-area { position: absolute; left: 12dp; right: 12dp; top: 40dp; bottom: 12dp; }
        /* (not clipped: a mark at its edge, such as a planet's pole, shows whole) */
        #bigmap-box { position: absolute; background-color: #24311f; border: 1dp #ffffff40; }
        #worldmap { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
        .bigmark { position: absolute; width: 14dp; height: 14dp; margin-left: -7dp;
                   margin-top: -7dp; border-radius: 7dp; background-color: #ffd27a;
                   border: 2dp #000000b0; }
        .bigmark.exit { background-color: #6fb6ff; border-radius: 3dp; }
        .bigmark.portal { background-color: #b07aff; border-color: #ffffffd0; }
        .bigmark-label { position: absolute; left: 16dp; width: 240dp; font-size: 14dp; }
        .bigmark-label.flip { left: -250dp; text-align: right; }
        #bigmap-player { position: absolute; width: 30dp; height: 30dp; margin-left: -15dp;
                         margin-top: -15dp; }
        #bigmap-player .nose { position: absolute; left: 11dp; top: 0; width: 8dp; height: 17dp;
                               background-color: #ff5a4a; border: 1dp #000000c0;
                               border-radius: 4dp; }
        #bigmap-player .body { position: absolute; left: 7dp; top: 11dp; width: 16dp;
                               height: 16dp; background-color: #ffffff; border: 2dp #ff5a4a;
                               border-radius: 8dp; }
        #bigmap-north { position: absolute; left: 50%; top: 4dp; width: 20dp; margin-left: -10dp;
                        text-align: center; font-size: 14dp; color: #ffffffd0; }
        #bigmap-wait { position: absolute; left: 0; right: 0; top: 45%; text-align: center;
                       font-size: 18dp; color: #d8dee8; }

        /* A phone held upright: the two sides share the width. */
        @media (orientation: portrait) {
            #bars { width: 44%; top: 52dp; }
            #right { width: 44%; top: 52dp; }
            #minimap { width: 120dp; height: 120dp; }
            #prompt { bottom: 150dp; }
        }
        /* With the touch controls (the stick and buttons fill the bottom corners): the minimap
           at the top right, the numbers under it, the prompt above the controls. */
        #frame.touch #minimap { top: 16dp; bottom: auto; width: 120dp; height: 120dp; }
        #frame.touch #right { top: 148dp; }
        @media (orientation: portrait) {
            #frame.touch #minimap { top: 52dp; width: 104dp; height: 104dp; }
            #frame.touch #right { top: 168dp; }
            #frame.touch #prompt { bottom: 280dp; }
        }
    </style>
</head>
<body data-model="hud">
    <div id="frame" data-if="visible" data-class-touch="touch">
        <div id="bars">
            <div class="stat shadow" data-for="bar : bars" data-attr-id="'bar-' + bar.id">
                <span class="name">{{bar.name}}</span><span class="value">{{bar.text}}</span>
                <div class="track"><div class="fill" data-style-width="bar.percent + '%'"></div></div>
            </div>
        </div>
        <div id="right">
            <div class="number shadow" data-for="n : numbers">
                <span class="name">{{n.name}} </span>{{n.text}}</div>
            <div class="timer shadow" data-for="t : timers">{{t.label}} {{t.text}}</div>
            <div id="notes">
                <div class="note" data-for="note : notes" data-style-opacity="note.opacity">{{note.text}}</div>
            </div>
        </div>
        <p id="prompt" data-if="has_prompt"><span class="shadow">{{prompt}}</span></p>
        <div id="crosshair" data-if="crosshair &amp;&amp; !crosshair_picture"></div>
        <div id="crosshair_picture" data-if="crosshair &amp;&amp; crosshair_picture"
             data-style-width="crosshair_size + 'dp'" data-style-height="crosshair_size + 'dp'"
             data-style-margin-left="crosshair_offset + 'dp'"
             data-style-margin-top="crosshair_offset + 'dp'"></div>
        <div id="compass" data-if="compass">
            <div id="strip" data-style-left="compass_left + 'dp'">
                <div data-for="m : compass_marks" class="tick" data-class-major="m.major">{{m.text}}</div>
            </div>
            <div id="needle"></div>
        </div>
        <div id="minimap" data-if="minimap &amp;&amp; !bigmap">
            <img id="ground" src="midgard://image/minimap" data-if="has_ground"
                 data-style-left="ground_left + '%'" data-style-top="ground_top + '%'"
                 data-style-width="ground_width + '%'" data-style-height="ground_width + '%'"/>
            <div class="mark" data-for="k : map_marks" data-class-exit="k.kind == 'exit'"
                 data-class-portal="k.kind == 'portal'"
                 data-style-left="k.left + '%'" data-style-top="k.top + '%'">
                <div class="mark-label shadow" data-if="k.label != ''">{{k.label}}</div>
            </div>
            <div id="arrow" data-style-transform="'rotate(' + arrow + 'deg)'">
                <div class="nose"></div><div class="body"></div>
            </div>
            <div id="north" class="shadow">N</div>
        </div>
        <div id="bigmap" data-if="bigmap">
            <div id="bigmap-title" class="shadow">Map<span id="bigmap-hint">{{bigmap_hint}}</span></div>
            <div id="bigmap-area">
                <div id="bigmap-box" data-style-left="bigmap_left + '%'"
                     data-style-top="bigmap_top + '%'" data-style-width="bigmap_width + '%'"
                     data-style-height="bigmap_height + '%'">
                    <img id="worldmap" src="midgard://image/worldmap" data-if="bigmap_ground"/>
                    <div class="bigmark" data-for="k : bigmap_marks"
                         data-class-exit="k.kind == 'exit'"
                         data-class-portal="k.kind == 'portal'"
                         data-style-left="k.left + '%'" data-style-top="k.top + '%'">
                        <div class="bigmark-label shadow" data-if="k.label != ''"
                             data-class-flip="k.flip"
                             data-style-top="(k.dy - 3) + 'dp'">{{k.label}}</div>
                    </div>
                    <div id="bigmap-player" data-style-left="bigmap_player_left + '%'"
                         data-style-top="bigmap_player_top + '%'"
                         data-style-transform="'rotate(' + bigmap_arrow + 'deg)'">
                        <div class="nose"></div><div class="body"></div>
                    </div>
                    <div id="bigmap-north" class="shadow">N</div>
                </div>
                <p id="bigmap-wait" class="shadow" data-if="!bigmap_ready">Drawing the map&#8230;</p>
            </div>
        </div>
    </div>
</body>
</rml>
