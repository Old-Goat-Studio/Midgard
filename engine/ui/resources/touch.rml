<rml>
<head>
    <title>Touch controls</title>
    <link type="text/rcss" href="midgard://base.rcss"/>
    <style>
        /* Midgard's touch controls (midgard/ui/touch.h): the controls take the fingers
           themselves, so nothing here takes the pointer. Places are in pixels from the safe
           area's top left (the body's padding), as the controls work them out. */
        body { pointer-events: none; font-size: 16dp; box-sizing: border-box; }
        #frame { position: relative; width: 100%; height: 100%; }
        div { pointer-events: none; }
        .ring, #knob, .button { box-sizing: border-box; }
        .ring { position: absolute; border: 2dp #ffffff70; background-color: #10141c40; }
        #stick.active { border-color: #ffffffb0; background-color: #10141c70; }
        #knob { position: absolute; background-color: #ffffff50; border: 2dp #ffffff90; }
        #knob.active { background-color: #ffd27ab0; border-color: #ffd27a; }
        .button { position: absolute; border: 2dp #ffffff90; background-color: #10141c90;
                  text-align: center; color: #ffffff; font-size: 15dp;
                  font-effect: shadow(1dp 1dp #000000c0); }
        .button.down { background-color: #ffd27ac0; border-color: #ffd27a; color: #10141c;
                       font-effect: none; }
        #touch-jump { font-size: 18dp; }
    </style>
</head>
<body data-model="touch">
    <div id="frame" data-if="shown">
        <div id="stick" class="ring" data-class-active="stick_active"
             data-style-left="stick_left + 'px'" data-style-top="stick_top + 'px'"
             data-style-width="stick_size + 'px'" data-style-height="stick_size + 'px'"
             data-style-border-radius="(stick_size / 2) + 'px'"></div>
        <div id="knob" data-class-active="stick_active"
             data-style-left="knob_left + 'px'" data-style-top="knob_top + 'px'"
             data-style-width="knob_size + 'px'" data-style-height="knob_size + 'px'"
             data-style-border-radius="(knob_size / 2) + 'px'"></div>
        <div class="button" data-for="b : buttons" data-if="b.shown"
             data-attr-id="'touch-' + b.id" data-class-down="b.down"
             data-style-left="b.left + 'px'" data-style-top="b.top + 'px'"
             data-style-width="b.size + 'px'" data-style-height="b.size + 'px'"
             data-style-line-height="b.size + 'px'"
             data-style-border-radius="(b.size / 2) + 'px'">{{b.label}}</div>
    </div>
</body>
</rml>
