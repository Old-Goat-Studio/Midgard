{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "midgard",
  "version": "0.1.0",
  "description": "Midgard game engine",
  "homepage": "https://github.com/Old-Goat-Studio/Midgard",
  "license": "Apache-2.0",
  "builtin-baseline": "44ccfd88b3eca6929d6d16398c7b19945c29a5f6",
  "dependencies": [
    "nlohmann-json",
    "sqlite3",
    "doctest",
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        "vulkan",
        { "name": "x11", "platform": "linux" },
        { "name": "wayland", "platform": "linux" }
      ]
    },
    "volk",
    "vulkan-headers",
    "vulkan-memory-allocator",
    "glm",
    "stb",
    "miniz",
    "cgltf",
    "mikktspace",
    { "name": "ktx", "default-features": false },
    "entt",
    { "name": "glslang", "host": true, "features": ["tools"] }
  ]
}
